# ARGUS node settings for the systemd service (deploy/argus-node.service).
# Copy to deploy/node.env and edit. node.env is git-ignored: it can hold a
# password. Every variable is documented in docs/reference/08-configuration.md.

# Who this camera is. NODE_NAME is how the aggregator tells nodes apart,
# so every node needs a different one.
NODE_NAME=Node A
CAMERA_ZONE=Front door

# The schedule. Rounds run every FL_ROUND_INTERVAL_DAYS at FL_ROUND_HOUR
# (24 h clock), and a round missed while the node was off runs 5 minutes
# after it starts.
FL_ENABLED=true
FL_ROUND_INTERVAL_DAYS=14
FL_ROUND_HOUR=2

# The aggregator (the laptop or server running central_server/fl_aggregator.py).
FL_SERVER_URL=10.0.0.239:8080
FL_CENTRAL_API=http://10.0.0.239:8090

# Keep auth on for anything reachable beyond a private LAN.
AUTH_REQUIRED=false
# ARGUS_ADMIN_PASSWORD=
# SECRET_KEY=

# Thermal monitor (on by default). Name the enclosure and how it is set up,
# so every row of data/thermal/thermal-YYYY-MM-DD.csv says what was tested.
THERMAL_ENCLOSURE=HighPi Pro 5S, closed, fan on
# THERMAL_SAMPLE_S=30

# Event clips. Only clips that overlap a priority-1 (anomaly) event are
# kept, re-encoded to H.264 (needs: sudo apt install ffmpeg), and capped
# at RECORD_MAX_GB; no clip starts below RECORD_MIN_FREE_GB free.
RECORD_EVENTS=true
RECORD_P1_ONLY=true
RECORD_MAX_GB=4
RECORD_MIN_FREE_GB=3
