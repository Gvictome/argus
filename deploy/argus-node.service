# ARGUS node as a service: starts on boot, restarts if it crashes, and
# stops cleanly on shutdown. The federated schedule lives inside the node
# process, so the node must always be running for rounds to happen.
#
# Install (on the PI, from ~/argus):
#   cp deploy/node.env.example deploy/node.env    # then edit it
#   sudo cp deploy/argus-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now argus-node
#   journalctl -u argus-node -f
#
# Paths assume the user `viccia` and the repo at /home/viccia/argus. Change User,
# WorkingDirectory, EnvironmentFile and ExecStart together if yours differ.

[Unit]
Description=ARGUS camera node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=viccia
WorkingDirectory=/home/viccia/argus
EnvironmentFile=/home/viccia/argus/deploy/node.env
ExecStart=/home/viccia/argus/scripts/run_node.sh
Restart=on-failure
RestartSec=10
# The SD card was corrupted once by an unclean stop. Give the camera,
# the clip writer and any running round time to finish before SIGKILL.
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
